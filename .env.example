OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4.1-mini

DATA_DIR=data
MEMORY_PATH=data/memory.json
TRACE_PATH=data/traces.jsonl
NOTES_DIR=data/notes

MAX_FILE_READ_CHARS=4000
MAX_HISTORY_MESSAGES=12
MAX_REPLAN_CYCLES=1

ENABLE_OPEN_APP=true
ENABLE_FILE_TOOLS=true
ENABLE_MEMORY_TOOLS=true

ENABLE_SKILLS=true
SKILLS_DIR=skills

SKILL_SELECTION_THRESHOLD=0.65
SKILL_RULE_MIN_MATCHES=2

EVAL_MODE=false
EVAL_FIXTURE_ROOT=
EVAL_ALLOW_REAL_SIDE_EFFECTS=false

ENABLE_LLM_JUDGE=false
JUDGE_MODEL=gpt-4.1-mini
JUDGE_WEIGHT=0.25

ENABLE_MCP_TOOLS=false
ENABLE_MOCK_MCP_TOOLS=false

ENABLE_REAL_MCP_TOOLS=false
MCP_SERVER_CONFIG_PATH=config/mcp_servers.json